# Environment variables for The Austin Collection.
# Copy to .env.local for local development. Nothing is required yet;
# later steps add Hospitable, Resend, and CSP settings here.

# Canonical origin, used for metadataBase (and canonical URLs, sitemap, OG
# images from step 11). Set per environment on Vercel; defaults to
# http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=
