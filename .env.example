# Environment variables for The Austin Collection.
# Copy to .env.local for local development. Nothing is required locally:
# without RESEND_API_KEY the contact route logs each inquiry instead of
# sending it.

# Canonical origin, used for metadataBase, canonical links, the sitemap, OG
# image URLs, and JSON-LD. Set per environment on Vercel (the final https
# origin in Production); defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Booking panel on the house pages: "stub" renders placeholder panels,
# "live" injects Hospitable's embedded widget from cdn.hsptb.com, "native"
# renders the site's own booking widget (components/booking) over the
# /api routes below. Overrides `site.hospitable.mode` in content/site.ts;
# inlined at build time, so set it per Vercel environment and redeploy.
NEXT_PUBLIC_HOSPITABLE_MODE=stub

# Direct-booking widget (the /api/properties, /api/calendar, /api/quote
# routes and the server-rendered first paint in native mode). Without the
# token the routes answer 503 NOT_CONFIGURED and the native widget says
# online booking is unavailable.
# HOSPITABLE_PERSONAL_ACCESS_TOKEN: a Public API v2 Personal Access Token
# (Hospitable → Apps → API access → Access tokens), read access is enough.
# Server-only: it is read in lib/booking/client.ts and nowhere else, and must
# never get a NEXT_PUBLIC_ prefix. HOSPITABLE_PAT is accepted as an alias.
HOSPITABLE_PERSONAL_ACCESS_TOKEN=
# HOSPITABLE_CUSTOM_SITE_ID: the `data-site-uuid` of the self-hosted Direct
# site (Hospitable → Direct → Sites → widget code); sent as `custom_site_id`
# on every quote so Hospitable's checkout attributes the booking to this site.
# Defaults to `site.hospitable.siteUuid` in content/site.ts when unset.
HOSPITABLE_CUSTOM_SITE_ID=
# Fallback per-channel markups in percent, used only for a house whose
# Hospitable listing_markups are missing. Hospitable's configured values win.
AIRBNB_MARKUP_PCT=15.5
DIRECT_MARKUP_PCT=11
# Optional JSON map of Hospitable property id → public Airbnb listing URL,
# overriding `airbnbUrl` in content/properties.ts for the comparison link.
AIRBNB_LISTING_URLS=
# "false" hides the Airbnb price comparison everywhere.
COMPARISON_ENABLED=true
# Longest stay the quote route will price.
MAX_NIGHTS=90
# Token (16+ chars) for GET /api/admin/comparison-check, the spot-check of
# the Airbnb estimate against the real host calendar; unset, the route is a
# 404. Generate one with `openssl rand -hex 24`.
BOOKING_ADMIN_TOKEN=
# Where the Public API lives. Leave unset; only the e2e suite overrides it,
# pointing the native build at e2e/mock-hospitable/server.mjs.
# HOSPITABLE_API_BASE_URL=https://public.api.hospitable.com/v2

# Contact form delivery (POST /api/contact) through Resend. Leave all three
# empty locally and in CI: the route then runs dry, logging the message and
# returning success. On Vercel (step 14) set all three for Production and
# Preview; a key without the two addresses makes the route return 500.
# RESEND_API_KEY: an API key from the Resend dashboard (open item: account).
RESEND_API_KEY=
# CONTACT_FROM: the sender, on the domain verified in Resend, e.g.
# "The Austin Collection <hello@<domain>>" (open item: domain and address).
CONTACT_FROM=
# CONTACT_TO: who receives inquiries; one address or a comma-separated list
# (open item: all three hosts or one shared inbox).
CONTACT_TO=

# Apple Maps for the city map (components/map/AppleCityMap.tsx). A MapKit JS
# token from the Apple Developer account: Certificates, Identifiers & Profiles
# → Services → Maps → Tokens → (+), token type "MapKit JS", restriction
# "Domain", listing the production domain and the Vercel preview domain.
# Domain-restricted tokens are meant to be public, hence NEXT_PUBLIC_. Inlined
# at build time. Leave empty to show the drawn SVG map instead (local and CI).
NEXT_PUBLIC_MAPKIT_TOKEN=
