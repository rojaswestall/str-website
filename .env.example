# Environment variables for The Austin Collection.
# Copy to .env.local for local development. Nothing is required yet;
# later steps add Resend and CSP settings here.

# Canonical origin, used for metadataBase (and canonical URLs, sitemap, OG
# images from step 11). Set per environment on Vercel; defaults to
# http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Hospitable widgets: "stub" renders the placeholder panels, "live" injects
# the loader from cdn.hsptb.com. Overrides `site.hospitable.mode` in
# content/site.ts; inlined at build time, so set it per Vercel environment.
NEXT_PUBLIC_HOSPITABLE_MODE=stub

# Set to 1 to keep the dev-only widget lab (/hospitable-lab) in a production
# build. Playwright sets this for its test servers; leave it empty on Vercel.
NEXT_PUBLIC_DEV_ROUTES=
